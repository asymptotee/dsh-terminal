{
  "name": "dsh-terminal",
  "version": "0.1.0-dev.0",
  "description": "Terminal UI plugin for DeepSeek Harness: mounts over the dsh-base profile layer through the dsh plugin mechanism, consuming the host runtime",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-terminal": "./bin/dsh-terminal.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./startup": "./dist/startup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "bin/",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/bundle.mjs && node scripts/verify-dist.mjs",
    "build:release": "node scripts/bundle.mjs --release && node scripts/verify-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "verify:contract": "tsx scripts/verify-contract.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "pnpm run typecheck && pnpm test && pnpm run verify:boundary && pnpm run verify:contract",
    "release:pack": "pnpm run build:release && pnpm run verify && pnpm pack",
    "prepublishOnly": "pnpm run build:release && pnpm run verify"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.5-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.0",
    "string-width": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.2"
  }
}
